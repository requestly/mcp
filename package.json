{
  "name": "@requestly/mcp",
  "version": "1.0.5",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "@requestly/mcp": "./build/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --platform=node --format=esm --outfile=build/index.js && chmod 755 build/index.js",
    "start": "node build/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "requestly",
    "mcp",
    "server",
    "rules",
    "groups"
  ],
  "author": "Requestly <contact@requestly.io>",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "description": "Requestly MCP server for rule and group management via stdio.",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.8",
    "typescript": "^5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
